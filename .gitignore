# --- Python Bytecode & Environments ---
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.uv-cache/
.tools/
venv/
ENV/
env/

# --- Large Datasets & Databases ---
*.csv
*.tsv
*.xlsx
*.duckdb
*.db
*.sqlite

# --- Confidential Compliance Records ---
# Compliance logs contain generated STRs with sensitive user data (card numbers, names, locations)
compliance_logs/
compliance_logs/*

# --- Machine Learning Models & Cache ---
# Large binary model checkpoints and cached parameters
models_artifacts/
ollama_cache/
*.joblib
*.pkl
*.pb
*.onnx
*.h5

# --- DBT (Data Build Tool) Artifacts ---
# DBT logs and compiled SQL target models
target/
logs/
# profiles.yml is intentionally NOT ignored: it contains no credentials, only a
# DuckDB path sourced from DBT_DB_PATH. Ignoring it made a fresh clone unable to
# run dbt ("Could not find profile named 'aegis_agent'").

# --- Terraform State & Secrets ---
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
*.tfvars.json

# --- Credentials & Configs ---
.env
.env.*
!.env.example
.user.yml
secrets.json
*credentials*
*.key
*.pem

# --- OS & IDE Metadata ---
.idea/
.vscode/
.DS_Store
Thumbs.db
