# Local demonstration only. Never copy development identity settings into deployment.
AEGIS_SECURITY_MODE=development
AEGIS_DEV_SUBJECT=local-investigator
AEGIS_DEV_ROLES=investigator
AEGIS_DEV_ORGANIZATION=local-demo

# Non-secret runtime configuration.
AWS_DEFAULT_REGION=us-east-1
COMPLIANCE_S3_BUCKET=

# Do not commit AWS credentials, Clerk keys, session tokens, or JWTs. Production
# secrets must be injected by the deployment platform's secret manager.
